# Copy to .env and fill in. Never commit .env.

# ---- Application ----
APP_ENV=dev                          # dev | staging | prod
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false                   # true in production

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=store_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ---- Vision / identity pipeline ----
FACE_MATCH_THRESHOLD=0.45            # cosine distance; lower = stricter
UNKNOWN_PROMOTION_VISITS=2           # visits required to promote unknown -> recurring customer
VISIT_IDLE_TIMEOUT_SECONDS=300       # close a visit after this much absence

# ---- Incident recorder ----
INCIDENT_PRE_ROLL_SECONDS=900        # 15 min before event
INCIDENT_POST_ROLL_SECONDS=120       # 2 min after event
INCIDENT_CLIP_DIR=./data/incidents

# ---- Storage ----
MEDIA_ROOT=./data/media
VIDEO_CHUNK_DIR=./data/chunks        # where captured video chunks land for batch processing
