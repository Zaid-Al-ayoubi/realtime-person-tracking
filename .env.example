# Application
APP_NAME="Store Analytics"
APP_VERSION="0.1.0"
DEBUG=false
SECRET_KEY="CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION"

# Database — async driver for FastAPI, sync driver for Alembic
DATABASE_URL="postgresql+asyncpg://analytics:analytics@localhost:5432/store_analytics"
DATABASE_URL_SYNC="postgresql://analytics:analytics@localhost:5432/store_analytics"

# Redis (Celery broker + result backend)
REDIS_URL="redis://localhost:6379/0"

# Vision — model paths relative to project root
PERSON_MODEL_PATH="models/yolov8m.pt"
FACE_MODEL_PATH="models/face_yolov8s.pt"
PERSON_CONF_THRESHOLD=0.4
FACE_CONF_THRESHOLD=0.4
FACE_STABILITY_FRAMES=3

# Identity resolution
FACE_SIMILARITY_THRESHOLD=0.55
RECURRING_CUSTOMER_MIN_VISITS=2

# Recording
RECORDINGS_DIR="recordings"
FACE_DB_DIR="face_db"
PRE_EVENT_BUFFER_SECONDS=900
POST_EVENT_RECORD_SECONDS=300
